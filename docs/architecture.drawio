<mxfile host="drawio" version="26.0.0">
  <diagram name="LOTO Quorum">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="LOTO Quorum: serverless N-of-N lockout/tagout gate (one SAM template, no servers)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="150" y="0" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="AWS Cloud (one region)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;html=1;fontSize=12;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="1430" height="760" as="geometry" />
        </mxCell>

